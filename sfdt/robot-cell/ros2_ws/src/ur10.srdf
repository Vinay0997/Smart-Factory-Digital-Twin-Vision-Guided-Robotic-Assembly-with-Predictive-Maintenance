<?xml version="1.0" ?>
<!--
  ur10.srdf
  Package: ur10_moveit_config
  Semantic robot description for MoveIt: planning groups, named poses,
  end-effector definition, and collision exclusions for the pick-and-place
  cell used by pick_place_node.py.
-->
<robot name="ur10_pick_place">

  <!-- Arm planning group: base through the 6 UR10 joints to tool0 -->
  <group name="ur10_arm">
    <chain base_link="base_link" tip_link="tool0" />
  </group>

  <!-- Gripper planning group -->
  <group name="ur10_gripper">
    <joint name="gripper_left_joint" />
    <joint name="gripper_right_joint" />
  </group>

  <!-- Named poses referenced by pick_place_node.py's POSES dict -->
  <group_state name="home" group="ur10_arm">
    <joint name="shoulder_pan_joint" value="0" />
    <joint name="shoulder_lift_joint" value="-1.5708" />
    <joint name="elbow_joint" value="1.5708" />
    <joint name="wrist_1_joint" value="-1.5708" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="0" />
  </group_state>

  <group_state name="observe" group="ur10_arm">
    <joint name="shoulder_pan_joint" value="0.4" />
    <joint name="shoulder_lift_joint" value="-1.2" />
    <joint name="elbow_joint" value="1.4" />
    <joint name="wrist_1_joint" value="-1.7" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="0" />
  </group_state>

  <group_state name="open" group="ur10_gripper">
    <joint name="gripper_left_joint" value="0.02" />
  </group_state>

  <group_state name="closed" group="ur10_gripper">
    <joint name="gripper_left_joint" value="0.0" />
  </group_state>

  <!-- End effector definition -->
  <end_effector name="ur10_gripper_ee" parent_link="tool0" group="ur10_gripper" />

  <!-- Virtual joint fixing the robot base to the world frame -->
  <virtual_joint name="world_to_base" type="fixed" parent_frame="world" child_link="base_link" />

  <!-- Collision exclusions between adjacent links to avoid false self-collision checks -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="wrist_3_link" link2="gripper_base" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="left_finger" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="right_finger" reason="Adjacent" />
  <disable_collisions link1="left_finger" link2="right_finger" reason="Default" />

</robot>
