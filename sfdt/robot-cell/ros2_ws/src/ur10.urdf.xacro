<?xml version="1.0"?>
<!--
  ur10.urdf.xacro
  Package: ur10_description
  Smart Factory Digital Twin - robot description for the pick-and-place cell.

  This wraps the official Universal Robots ROS2 description macros
  (ros-industrial/Universal_Robots_ROS2_Description) rather than
  reimplementing UR10 kinematics from scratch, then adds a simple
  parallel gripper and mounts the arm at the pick-station pose used
  in assembly_station.world.

  Prerequisite: install the upstream description package, e.g.
      sudo apt install ros-humble-ur-description
  or clone it into your workspace src/ if building from source.
-->
<robot name="ur10_pick_place" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="ur_type" default="ur10" />
  <xacro:arg name="tf_prefix" default="" />

  <!-- Pull in the standard UR macro from the upstream ur_description package -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />

  <!-- World -> robot base mount, positioned per assembly_station.world layout -->
  <link name="world" />

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.45" rpy="0 0 0" />
  </joint>

  <xacro:ur_robot
    name="ur10_pick_place"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur10_description)/config/joint_limits.yaml"
    kinematics_parameters_file="$(find ur10_description)/config/default_kinematics.yaml"
    physical_parameters_file="$(find ur10_description)/config/physical_parameters.yaml"
    visual_parameters_file="$(find ur10_description)/config/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <!-- Simple parallel gripper mounted on the tool0 flange -->
  <link name="gripper_base">
    <visual>
      <geometry><box size="0.06 0.06 0.05" /></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1" /></material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.06 0.05" /></geometry>
    </collision>
    <inertial>
      <mass value="0.3" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>

  <joint name="tool0_to_gripper" type="fixed">
    <parent link="tool0" />
    <child link="gripper_base" />
    <origin xyz="0 0 0.03" rpy="0 0 0" />
  </joint>

  <link name="left_finger">
    <visual><geometry><box size="0.01 0.02 0.06" /></geometry></visual>
    <collision><geometry><box size="0.01 0.02 0.06" /></geometry></collision>
    <inertial><mass value="0.02" /><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" /></inertial>
  </link>

  <link name="right_finger">
    <visual><geometry><box size="0.01 0.02 0.06" /></geometry></visual>
    <collision><geometry><box size="0.01 0.02 0.06" /></geometry></collision>
    <inertial><mass value="0.02" /><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" /></inertial>
  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base" />
    <child link="left_finger" />
    <origin xyz="-0.02 0 0.05" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0.0" upper="0.02" effort="20" velocity="0.05" />
  </joint>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base" />
    <child link="right_finger" />
    <origin xyz="0.02 0 0.05" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="0.0" upper="0.02" effort="20" velocity="0.05" />
    <mimic joint="gripper_left_joint" multiplier="1.0" offset="0.0" />
  </joint>

  <!-- Camera mount reference frame, matches inspection_camera pose in
       assembly_station.world for TF-based coordination if needed -->
  <link name="inspection_camera_frame" />
  <joint name="world_to_camera" type="fixed">
    <parent link="world" />
    <child link="inspection_camera_frame" />
    <origin xyz="1.2 0.0 1.2" rpy="0 1.5708 0" />
  </joint>

</robot>
